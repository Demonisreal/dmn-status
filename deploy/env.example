# kopieren nach .env, chmod 600.
ADDR=:8080
DB_PATH=/data/status.db
BASE_URL=https://status.example.com
# cidr des status_edge-netzes, in dem der vorgeschaltete caddy haengt (siehe docker-compose.yml).
# nur x-forwarded-for aus diesem subnetz wird ausgewertet, leer = x-forwarded-for wird komplett ignoriert
TRUSTED_PROXY=172.20.0.0/24
COOKIE_SECURE=true
# kommagetrennte host:port-allowlist, nur fuer connect_to noetig (address bleibt immer oeffentlich)
PRIVATE_ALLOW=caddy:443
RETENTION_DAYS=30
METRICS_TOKEN=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
# abhaengig vom anbieter
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_TO=

# nur fuer den ersten start, danach aus der .env entfernen und
# docker compose up -d --force-recreate (sonst steht der wert noch in der container-config,
# sichtbar per docker inspect - .env-werte sind fuer jeden mit docker-zugriff lesbar). besser:
# docker compose exec -T dmn-status /dmn-status admin set-password <name>  (passwort ueber stdin)
ADMIN_USER=
ADMIN_PASSWORD=
